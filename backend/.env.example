# Backend env, read by config.py. Copy to backend/.env.
# Only machine-specific values and secrets live here; everything else is in config.py.

# Hugging Face token (only needed if the dataset repo is private or gated)
HF_TOKEN=

# Database for the report API (SQLite file by default; a postgresql:// URL also works)
DATABASE_URL=sqlite:///./data/app.db

# MLflow tracking server (run `mlflow ui` or docker compose)
MLFLOW_TRACKING_URI=http://localhost:5000

# Training device: 0 = first GPU, "0,1" = two GPUs, cpu, mps (Apple Silicon)
DEVICE=0

# Comma-separated origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# Where uploaded photos and annotated images are saved
MEDIA_DIR=./data/media

# Weights served by the API. Empty = use the MLflow champion (SCRUM-28)
SERVER_WEIGHTS=
